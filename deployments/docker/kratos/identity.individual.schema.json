{
  "$id": "https://oecs.dev/schema/identity/individual.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OECS Hub individual identity",
  "type": "object",
  "properties": {
    "traits": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "title": "Email",
          "minLength": 3,
          "ory.sh/kratos": {
            "credentials": {
              "password": { "identifier": true },
              "webauthn": { "identifier": true }
            },
            "verification": { "via": "email" },
            "recovery": { "via": "email" }
          }
        },
        "name": {
          "type": "string",
          "title": "Full name"
        },
        "billingAddress": {
          "type": "object",
          "title": "Billing address",
          "properties": {
            "streetAddress": { "type": "string", "title": "Street address" },
            "postalCode": { "type": "string", "title": "Postal code" },
            "country": { "type": "string", "title": "Country" }
          },
          "required": ["streetAddress", "postalCode", "country"]
        }
      },
      "required": ["email", "billingAddress"],
      "additionalProperties": false
    }
  }
}
