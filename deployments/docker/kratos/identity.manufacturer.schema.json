{
  "$id": "https://oecs.dev/schema/identity/manufacturer.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OECS Hub manufacturer identity",
  "type": "object",
  "properties": {
    "traits": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "title": "Email",
          "minLength": 3,
          "ory.sh/kratos": {
            "credentials": {
              "password": { "identifier": true },
              "webauthn": { "identifier": true }
            },
            "verification": { "via": "email" },
            "recovery": { "via": "email" }
          }
        },
        "name": {
          "type": "string",
          "title": "Full name"
        },
        "company": {
          "type": "object",
          "title": "Company",
          "$comment": "Not required: a nested `required` here would block free-plan signups, which never fill this in.",
          "properties": {
            "name": { "type": "string", "title": "Company name" },
            "streetAddress": { "type": "string", "title": "Street address" },
            "postalCode": { "type": "string", "title": "Postal code" },
            "country": { "type": "string", "title": "Country" }
          }
        }
      },
      "required": ["email"],
      "additionalProperties": false
    }
  }
}
