# Copy to .env.local (gitignored) to enable locally. See src/lib/chat/config.ts - this
# only toggles the UI; the feature also needs the backend's own Chat config set (see
# cmd/app/config.go's OECS_HUB_CHAT_CONVERSATION_ADDRESS/OECS_HUB_CHAT_AGENT_ADDRESS).
#
# VITE_FEATURE_CHAT=true

# Toggles the /billing UI. Talks directly to oecs-billing-service via its own
# BILLING_API_URL, same pattern as chat's CONVERSATION_API_URL above.
#
# VITE_FEATURE_BILLING=true
